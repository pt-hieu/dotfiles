# Ghostty config — ported from wezterm/wezterm.lua
# Docs: ghostty +show-config --default --docs

# Font — brew install --cask font-cascadia-code-nf
# The Nerd Font build is used so powerlevel10k's glyphs render. Italics ship as
# a separate family, so they must be named explicitly.
font-family = Cascadia Code NF
font-family-italic = Cascadia Code NF Italic
font-family-bold-italic = Cascadia Code NF Italic
font-size = 14

# Aura Dark, shared with Rex: themes/aura-dark-wezterm
theme = aura-dark-wezterm

# Splits — wezterm desaturated the inactive pane (inactive_pane_hsb);
# ghostty can only dim it.
split-divider-color = #a277ff
unfocused-split-opacity = 0.85

# Window
window-save-state = never

# Cells rarely divide evenly into the window; balance splits the leftover
# pixels across both edges instead of piling them on the right and bottom.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

background-opacity = 0.85
background-blur = 30
macos-titlebar-style = tabs

# Keybinds
# Already ghostty defaults, no need to redeclare: cmd+d / cmd+shift+d split
# right/down, cmd+[ / cmd+] focus prev/next split, cmd+left / cmd+right send
# ^A / ^E, cmd+backspace sends ^U, cmd+t new tab, cmd+w close.

# Newline without submitting (Claude Code, REPLs)
keybind = shift+enter=text:\x1b\r

# Scrollback jumps — override ghostty's default jump_to_prompt
keybind = super+up=scroll_to_top
keybind = super+down=scroll_to_bottom

# Pane resizing with alt+hjkl
keybind = alt+h=resize_split:left,15
keybind = alt+j=resize_split:down,15
keybind = alt+k=resize_split:up,15
keybind = alt+l=resize_split:right,15

# Updates
# The channel defaults to whatever build is running; stable would pin this
# install to tagged releases.
auto-update-channel = tip
