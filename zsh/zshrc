# =============================================================================
# P10k Instant Prompt (must stay at top)
# =============================================================================
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =============================================================================
# Completions (cached compinit — rebuild dump only if older than 24h)
# =============================================================================
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# =============================================================================
# Environment & PATH
# =============================================================================

# mise (Node/Python/etc version manager — replaces nvm, ~instant startup)
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

export EDITOR="nvim"
export CLAUDE_CODE_NO_FLICKER="1"

# pnpm (cross-platform)
if [[ "$OSTYPE" == "darwin"* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH" ;;
esac

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# pipx
export PATH="$PATH:$HOME/.local/bin"

# WezTerm (macOS only)
[[ -d /Applications/WezTerm.app/Contents/MacOS ]] && export PATH="$PATH:/Applications/WezTerm.app/Contents/MacOS"

# curl and git CA bundle (macOS only): Homebrew's bundle rejects the compromised eMudhra intermediates that /etc/ssl/cert.pem still trusts
if [[ -f /opt/homebrew/etc/ca-certificates/cert.pem ]]; then
  export CURL_CA_BUNDLE="/opt/homebrew/etc/ca-certificates/cert.pem"
  export GIT_SSL_CAINFO="/opt/homebrew/etc/ca-certificates/cert.pem"
fi

# Claude Code MCP CLI
export ENABLE_EXPERIMENTAL_MCP_CLI=true

# =============================================================================
# Cross-platform Plugins
# =============================================================================

# Powerlevel10k
if [[ -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
elif [[ -f /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme ]]; then
  source /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme
fi

# Autosuggestions
if [[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [[ -f /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Syntax highlighting (must be last plugin sourced)
if [[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# =============================================================================
# Key Bindings
# =============================================================================

# Vi mode (set after plugins so their bindkey calls do not override it)
bindkey -v

# Esc is the first byte of every arrow/function-key sequence, so ZLE waits
# KEYTIMEOUT hundredths of a second to see whether more bytes follow before
# deciding Esc was pressed alone. The default 40 makes insert -> normal feel
# laggy; 1 still catches real sequences, which arrive in a single burst.
KEYTIMEOUT=1

# =============================================================================
# Tool Init
# =============================================================================

if command -v zoxide &> /dev/null; then
  eval "$(zoxide init zsh)"
fi

# Claude Code's Bash tool snapshots this file: eza glyphs corrupt piped ls output, and nomatch kills unquoted globs like --include=*.md
if [[ -n $CLAUDECODE ]]; then
  setopt no_nomatch
elif command -v eza &> /dev/null; then
  alias ls="eza --icons=always"
fi

