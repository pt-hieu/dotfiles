# Tab title with git branch
precmd() {
  local branch=$(git branch --show-current 2>/dev/null)
  if [[ -n $branch ]]; then
    echo -ne "\033]0;$(basename "$PWD") [$branch]\007"
  else
    echo -ne "\033]0;$(basename "$PWD")\007"
  fi
}

# =============================================================================
# Functions: Git
# =============================================================================

function find_branch() {
  git branch -l \*$1\* | xargs
}

function br() {
  if [ ! -z "$1" ]; then
    find_branch "$1"
  else
    git rev-parse --abbrev-ref HEAD
  fi
}

function aa() {
  git add .
	echo "All changes staged!"
}

function cm() {
  BRANCH_NAME=$(br)
  JIRA_TICKET=$(echo $BRANCH_NAME | grep -oE '[A-Z]+-[0-9]+')
  if [ ! -z "$JIRA_TICKET" ]; then
    git commit -nm "$JIRA_TICKET $@"
  else
    git commit -nm "$@"
  fi
}

function cmm() {
  git commit --amend --no-edit -n
}

function co() {
  BRANCH=$(find_branch "$1")
  git checkout "$BRANCH"
}

function new() {
  git checkout -b "$@"
}

function push() {
  git push origin $(br) "$@"
}

function pull() {
  git pull origin $(br) "$@"
}

function mm() {
  git pull origin main
}

# Main repo root, resolved through the shared .git dir so it is the same from
# inside any of its worktrees.
function repo_root() {
  local git_common_dir
  git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  echo "${git_common_dir:h}"
}

# Jump between the Claude Code worktrees in <repo>/.claude/worktrees.
#   wt          go to the main repo root
#   wt card     go to the worktree whose name contains "card"
function wt() {
  local root
  root=$(repo_root) || { echo "wt: not in a git repo" >&2; return 1 }
  [[ -z "$1" ]] && { cd "$root"; return }

  local worktrees_dir="$root/.claude/worktrees"
  if [[ -d "$worktrees_dir/$1" ]]; then
    cd "$worktrees_dir/$1"
    return
  fi

  local matches=("$worktrees_dir"/*$1*(N/))
  case ${#matches} in
    0) echo "wt: no worktree matching '$1'" >&2; return 1 ;;
    1) cd "${matches[1]}" ;;
    *) echo "wt: '$1' matches several worktrees:" >&2
       printf '  %s\n' "${matches[@]:t}" >&2
       return 1 ;;
  esac
}

function _wt() {
  local root
  root=$(repo_root) || return 1
  compadd -- "$root"/.claude/worktrees/*(N/:t)
}
compdef _wt wt

